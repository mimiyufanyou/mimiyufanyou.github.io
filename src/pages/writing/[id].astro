---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getWriting, fmtDate } from "../../data";

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---

<Base title={d.title} description={d.summary} image={d.image}>
  <article>
    <p class="eyebrow">
      <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>{d.wip && " · Work in progress"}{d.draft && " · DRAFT"}
    </p>
    <h1 class="measure">{d.title}</h1>
    {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
    <div class="prose">
      <Content />
    </div>
    <p><a href="/writing/">← All writing</a></p>
  </article>
</Base>

<style>
  .prose { margin-top: 2rem; }
</style>
