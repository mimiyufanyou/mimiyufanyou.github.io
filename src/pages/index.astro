---
import Base from "../layouts/Base.astro";
import { getPosts, getProjects, shortDate } from "../data";

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <section>
    <p>Hello.</p>
    <p>
      I've spent ten years distilling phenomena into insights, exploring novel data sources, and hopefully
      making some interesting things. Recently I've been building human-in-the-loop AI systems.
    </p>
    <p>
      This is my digital home for <a href="/projects">projects</a>, <a href="/blog">writing</a> and anything
      else that comes to mind. If you'd like to reach out about opportunities, see <a href="/contact">Get In Touch</a>.
    </p>

    <div class="divider"></div>

    {projects.length > 0 && (
      <>
        <h3 class="year">Projects</h3>
        <ul class="list">
          {projects.map((p) => (
            <li>
              <div class="post-date code"><span>{p.data.years}</span></div>
              <a class="title" href={p.data.url}>{p.data.title} ↗</a>
            </li>
          ))}
        </ul>
      </>
    )}

    <h3 class="year">Recent writing</h3>
    <ul class="list">
      {posts.map((p) => (
        <li>
          <div class="post-date code"><span>{shortDate(p.data.date)}</span></div>
          <a class="title" href={`/blog/${p.id}`}>{p.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>
