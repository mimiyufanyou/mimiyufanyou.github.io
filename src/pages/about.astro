---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";

const roles = [
  { org: "Amazon Games", role: "Data Scientist II", years: "2023–2026" },
  { org: "Niantic", role: "Data Scientist (Lead)", years: "2021–2023" },
  { org: "Rockstar Games", role: "Senior Data Analyst", years: "2020–2021" },
  { org: "Mountain Equipment Co-op", role: "Lead Marketing Data Analyst", years: "2018–2020" },
  { org: "Electronic Arts · FIFA", role: "Business Data Analyst", years: "2015–2017" },
];
---

<Base title="About" description={SITE.description}>
  <div class="prose">
    <h1>About</h1>
    <p>
      I'm a data scientist in Seattle. I've spent ten years working out why numbers move in games and retail,
      and building the models, pipelines and dashboards that let teams act on it.
    </p>
    <p>
      Since mid-2026 I've been building human-in-the-loop AI systems: coding agents that work from a ticket
      board and stop at review, self-hosted image and voice models on my own GPU server, and evaluations that
      decide when a model is good enough to use.
    </p>
    <p>
      I'm open to remote contracts of 6 to 12 weeks in analytics, data science or applied AI.
    </p>

    <h2>Where I've worked</h2>
    <ul class="roles">
      {roles.map((r) => (
        <li><strong>{r.org}</strong> <span>{r.role}</span> <span class="muted">{r.years}</span></li>
      ))}
    </ul>

    <h2>Education</h2>
    <ul>
      <li>Bachelor of Commerce, University of British Columbia</li>
      <li>Post-Baccalaureate in Counseling and Psychology, UC Berkeley Extension</li>
    </ul>

    <h2>Elsewhere</h2>
    <ul>
      {SITE.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</Base>

<style>
  .roles { list-style: none; padding: 0; }
  .roles li {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 36rem) {
    .roles li { grid-template-columns: 1fr auto; }
    .roles li span:first-of-type { grid-column: 1; grid-row: 2; }
  }
</style>
