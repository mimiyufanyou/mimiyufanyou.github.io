---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";

const roles = [
  { org: "Amazon Games", role: "Data Scientist II", years: "2023–2026" },
  { org: "Niantic", role: "Data Scientist (Lead)", years: "2021–2023" },
  { org: "Rockstar Games", role: "Senior Data Analyst", years: "2020–2021" },
  { org: "Mountain Equipment Co-op", role: "Lead Marketing Data Analyst", years: "2018–2020" },
  { org: "Electronic Arts · FIFA", role: "Business Data Analyst", years: "2015–2017" },
];
---

<Base title="About" description={SITE.description}>
  <article>
    <div class="center"><h1 class="title">About</h1></div>
    <div class="divider"></div>
    <p>
      I'm a data scientist in Seattle. I've spent ten years working out why numbers move in games and retail,
      and building the models, pipelines and dashboards that let teams act on it.
    </p>
    <p>
      Since mid-2026 I've been building human-in-the-loop AI systems: coding agents that work from a ticket
      board and stop at review, self-hosted image and voice models on my own GPU server, and evaluations that
      decide when a model is good enough to use.
    </p>
    <p>I'm open to remote contracts of 6 to 12 weeks in analytics, data science or applied AI.</p>

    <h3 class="year">Experience</h3>
    <ul class="list">
      {roles.map((r) => (
        <li>
          <div class="post-date code"><span>{r.years}</span></div>
          <strong>{r.org}</strong><br /><span class="muted">{r.role}</span>
        </li>
      ))}
    </ul>

    <h3 class="year">Education</h3>
    <ul class="list">
      <li><strong>University of British Columbia</strong><br /><span class="muted">Bachelor of Commerce</span></li>
      <li><strong>UC Berkeley Extension</strong><br /><span class="muted">Post-Baccalaureate in Counseling and Psychology</span></li>
    </ul>
  </article>
</Base>
