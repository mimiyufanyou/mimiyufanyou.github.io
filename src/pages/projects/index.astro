---
import Base from "../../layouts/Base.astro";
import { getProjects } from "../../data";

const projects = await getProjects();
---

<Base title="Projects" description="Personal projects: The Little Language Club and Stream Montessori.">
  <section>
    <div class="center"><h1 class="title">Projects</h1></div>
    <div class="divider"></div>

    <ul class="list">
      {projects.map((p) => (
        <li>
          <div class="post-date code"><span>{p.data.years}</span></div>
          <a class="title" href={p.data.url}>
            <img class="preview" src={p.data.image} alt="" loading="lazy" />
            {p.data.title} ↗
          </a>
          <p>{p.data.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
