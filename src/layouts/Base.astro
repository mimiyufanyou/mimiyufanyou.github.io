---
import "../styles/global.css";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ""), Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\.html$/, "");
const menu = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Get In Touch" },
];
const isHere = (href: string) => path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>

    <aside class="logo">
      <a href="/" aria-label="Back to Index"><img src={SITE.avatar} alt="" width="90" height="90" /></a>
      <span class="logo-prompt code">Back to Index</span>
    </aside>

    <nav class="menu" aria-label="Main">
      <ul>
        {menu.map((m) => (
          <li><a href={m.href} aria-current={isHere(m.href) ? "page" : undefined}>{m.label}</a></li>
        ))}
      </ul>
    </nav>

    <main id="content">
      <slot />
    </main>

    <div class="footer">
      <span class="block">&copy; {new Date().getFullYear()} {SITE.name}</span>
      <span class="block"><small>&lt;/&gt; Built with <a href="https://astro.build">Astro</a>, in the style of <a href="https://github.com/heiswayi/the-plain">The Plain</a>.</small></span>
    </div>
  </body>
</html>
